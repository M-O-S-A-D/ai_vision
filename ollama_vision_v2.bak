#!/usr/bin/env python3
"""
Real-time camera analysis using Ollama vision models.

Architecture: 3 threads
  1. Camera capture (~30 FPS) — smooth video feed
  2. AI analysis (independent) — runs at configurable interval
  3. HTTP server on port 5000 — web UI

Camera and AI are fully decoupled so video stays smooth
even while the model is thinking (slow on CPU).
"""

import cv2
import base64
import requests
import threading
import time
import json
import numpy as np
from http.server import HTTPServer, BaseHTTPRequestHandler
from datetime import datetime

# ── Config ──────────────────────────────────────────────────────────────────
OLLAMA_URL            = "http://localhost:11434"
PREFERRED_MODELS      = ["moondream", "llava", "bakllava", "llava:13b"]
PROMPT                = "Describe what you see in this image concisely in 1-2 sentences."
ANALYSIS_INTERVAL     = 3.0        # seconds between analyses (gentler on CPU)
WEB_PORT              = 5000
SCENE_CHANGE_THRESH   = 12.0       # % pixel change to trigger re-analysis
CPU_TIMEOUT           = 180        # generous timeout for CPU-only inference
# ────────────────────────────────────────────────────────────────────────────


# ── Model detection ─────────────────────────────────────────────────────────
def detect_models():
    """Query Ollama for installed models, return list of names."""
    try:
        r = requests.get(f"{OLLAMA_URL}/api/tags", timeout=5)
        r.raise_for_status()
        models = r.json().get("models", [])
        return [m["name"] for m in models]
    except Exception:
        return []


def pick_best_model(available):
    """Pick the fastest available vision-capable model for CPU."""
    short = [n.split(":")[0] for n in available]
    for pref in PREFERRED_MODELS:
        base = pref.split(":")[0]
        if pref in available:          # exact match  e.g. "llava:13b"
            return pref
        if base in short:              # base match   e.g. "llava" → "llava:latest"
            idx = short.index(base)
            return available[idx]
    return available[0] if available else "llava"


# ── Shared state ─────────────────────────────────────────────────────────────
prompt = PROMPT

state = {
    "frame_b64":        None,
    "latest_frame_b64": None,
    "description":      "Starting camera…",
    "model":            "llava",
    "interval":         ANALYSIS_INTERVAL,
    "running":          True,
    "paused":           False,
    "analysing":        False,
    "frame_count":      0,
    "analysis_count":   0,
    "error":            None,
    "available_models": [],
    "history":          [],
    "scene_change_pct": 0.0,
}


# ── Ollama call ──────────────────────────────────────────────────────────────
def analyse_frame(frame_b64: str) -> str:
    """Send a base64 JPEG frame to Ollama and return the text description."""
    try:
        payload = {
            "model":  state["model"],
            "prompt": prompt,
            "images": [frame_b64],
            "stream": False,
        }
        r = requests.post(
            f"{OLLAMA_URL}/api/generate",
            json=payload,
            timeout=CPU_TIMEOUT,
        )
        r.raise_for_status()
        return r.json().get("response", "No response").strip()

    except requests.exceptions.ConnectionError:
        return "❌ Cannot connect to Ollama — is it running?  →  ollama serve"
    except requests.exceptions.Timeout:
        return (f"⏱️ Ollama timed out ({CPU_TIMEOUT}s). "
                "Try a smaller model like moondream.")
    except requests.exceptions.HTTPError as e:
        code = e.response.status_code if e.response is not None else "?"
        if code == 404:
            return (f"❌ Model '{state['model']}' not found. "
                    f"Pull it first:  ollama pull {state['model']}")
        return f"❌ HTTP {code}: {e}"
    except Exception as e:
        return f"Error: {e}"


# ── Scene-change detection ───────────────────────────────────────────────────
_prev_gray = None


def scene_changed(frame_b64: str) -> tuple:
    """Return (changed: bool, pct_diff: float)."""
    global _prev_gray
    try:
        raw   = base64.b64decode(frame_b64)
        arr   = np.frombuffer(raw, dtype=np.uint8)
        gray  = cv2.imdecode(arr, cv2.IMREAD_GRAYSCALE)
        small = cv2.resize(gray, (160, 120))

        if _prev_gray is None:
            _prev_gray = small
            return True, 100.0

        diff = cv2.absdiff(_prev_gray, small)
        pct  = (np.count_nonzero(diff > 25) / diff.size) * 100
        _prev_gray = small
        return pct > SCENE_CHANGE_THRESH, round(pct, 1)
    except Exception:
        return True, 0.0


# ── Thread 1: Camera capture (~30 FPS) ──────────────────────────────────────
def camera_loop():
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        state["description"] = "❌ Cannot open camera — check connection."
        state["error"] = "no_camera"
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    state["description"] = f"Camera ready — model: {state['model']}"

    while state["running"]:
        ret, frame = cap.read()
        if not ret:
            time.sleep(0.05)
            continue

        _, buf = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 75])
        b64 = base64.b64encode(buf).decode("utf-8")
        state["frame_b64"]        = b64     # for live display
        state["latest_frame_b64"] = b64     # for AI analysis
        state["frame_count"]     += 1
        time.sleep(0.033)                   # ~30 FPS

    cap.release()


# ── Thread 2: AI analysis (independent cadence) ─────────────────────────────
def analysis_loop():
    time.sleep(1.0)  # wait for first frame

    while state["running"]:
        if state["paused"]:
            time.sleep(0.5)
            continue

        frame = state.get("latest_frame_b64")
        if frame:
            changed, pct = scene_changed(frame)
            state["scene_change_pct"] = pct

            if changed:
                state["analysing"] = True
                desc = analyse_frame(frame)
                state["description"]    = desc
                state["analysis_count"] += 1
                state["analysing"]      = False

                # Record history (most recent first, cap at 100)
                state["history"].insert(0, {
                    "time":        datetime.now().strftime("%H:%M:%S"),
                    "description": desc,
                    "change_pct":  pct,
                })
                if len(state["history"]) > 100:
                    state["history"] = state["history"][:100]

        time.sleep(state["interval"])


# ── HTML / JS UI ─────────────────────────────────────────────────────────────
HTML = r"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ollama Vision — Live Camera</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Space+Grotesk:wght@300;500;700&display=swap');

  :root {
    --bg: #0a0a0f; --panel: #111118; --border: #1e1e2e;
    --accent: #7c3aed; --accent2: #06b6d4; --text: #e2e8f0;
    --muted: #64748b; --green: #10b981; --red: #f43f5e;
    --amber: #f59e0b;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg); color: var(--text);
    font-family: 'Space Grotesk', sans-serif; min-height: 100vh;
    display: flex; flex-direction: column;
  }

  /* ── Header ─────────────────────────────────────────────── */
  header {
    padding: 1.2rem 2rem; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 1rem; background: var(--panel);
  }
  .logo { font-size: 1.1rem; font-weight: 700; letter-spacing: -.02em; }
  .logo span { color: var(--accent2); }

  .status-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--green);
    animation: pulse 2s infinite; margin-left: auto;
  }
  .status-dot.busy    { background: var(--accent); }
  .status-dot.paused  { background: var(--amber); animation: none; }
  @keyframes pulse {
    0%,100% { opacity:1; transform:scale(1); }
    50%     { opacity:.5; transform:scale(1.3); }
  }
  .status-label {
    font-size: .8rem; color: var(--muted);
    font-family: 'DM Mono', monospace;
  }

  /* ── Main grid ──────────────────────────────────────────── */
  main {
    flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  }
  .panel {
    padding: 1.5rem; border-right: 1px solid var(--border);
    overflow-y: auto;
  }
  .panel:last-child { border-right: none; }

  .panel-title {
    font-size: .7rem; font-weight: 500; letter-spacing: .12em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 1rem;
    font-family: 'DM Mono', monospace;
  }

  /* ── Camera feed ────────────────────────────────────────── */
  #camera-feed {
    width: 100%; border-radius: 8px; border: 1px solid var(--border);
    background: #000; display: block; aspect-ratio: 4/3; object-fit: cover;
  }

  /* ── Description box ────────────────────────────────────── */
  .description-box {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 8px; padding: 1.2rem; min-height: 120px;
    font-size: 1rem; line-height: 1.6; position: relative;
    transition: border-color .3s; overflow: hidden;
  }
  .description-box.thinking { border-color: var(--accent); }
  .description-box.thinking::before {
    content: ''; position: absolute; inset: -1px; border-radius: 8px;
    background: linear-gradient(90deg, transparent, rgba(124,58,237,.15), transparent);
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }

  /* ── Meta badges ────────────────────────────────────────── */
  .meta { margin-top: 1rem; display: flex; gap: .6rem; flex-wrap: wrap; }
  .meta-item {
    font-family: 'DM Mono', monospace; font-size: .75rem; color: var(--muted);
    background: var(--panel); border: 1px solid var(--border);
    padding: .3rem .6rem; border-radius: 4px;
  }
  .meta-item strong { color: var(--accent2); }

  /* ── Controls ───────────────────────────────────────────── */
  .controls {
    margin-top: 1.5rem; display: flex; flex-direction: column; gap: .8rem;
  }
  label {
    font-size: .8rem; color: var(--muted); display: block; margin-bottom: .3rem;
  }
  select, input[type=range] {
    width: 100%; background: var(--panel); border: 1px solid var(--border);
    color: var(--text); padding: .5rem .8rem; border-radius: 6px;
    font-family: 'DM Mono', monospace; font-size: .85rem;
    outline: none; cursor: pointer;
  }
  select:focus { border-color: var(--accent); }
  .range-val { font-family: 'DM Mono', monospace; font-size: .8rem; color: var(--accent2); }

  textarea {
    width: 100%; background: var(--panel); border: 1px solid var(--border);
    color: var(--text); padding: .5rem .8rem; border-radius: 6px;
    font-family: 'DM Mono', monospace; font-size: .85rem;
    outline: none; resize: vertical; min-height: 60px;
  }
  textarea:focus { border-color: var(--accent); }

  /* ── Buttons ────────────────────────────────────────────── */
  .btn-row { display: flex; gap: .6rem; flex-wrap: wrap; }
  button {
    background: var(--accent); color: #fff; border: none;
    padding: .55rem 1.2rem; border-radius: 6px;
    font-family: 'Space Grotesk', sans-serif; font-weight: 600;
    font-size: .85rem; cursor: pointer; transition: opacity .2s;
  }
  button:hover { opacity: .85; }
  button.secondary { background: var(--border); color: var(--text); }
  button.warn      { background: var(--amber); color: #000; }

  /* ── History ────────────────────────────────────────────── */
  .history {
    margin-top: .8rem; display: flex; flex-direction: column; gap: .6rem;
    max-height: 300px; overflow-y: auto;
  }
  .history-item {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 6px; padding: .6rem .8rem; font-size: .82rem;
    line-height: 1.5; color: var(--muted); animation: fadeIn .3s ease;
  }
  @keyframes fadeIn {
    from { opacity:0; transform:translateY(4px); }
    to   { opacity:1; transform:none; }
  }
  .history-item .ts {
    font-family: 'DM Mono', monospace; font-size: .7rem;
    color: var(--accent); margin-bottom: .2rem;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 700px) {
    main { grid-template-columns: 1fr; }
    .panel { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>
</head>
<body>

<header>
  <div class="logo">ollama <span>vision</span></div>
  <div class="status-label" id="status-label">initialising</div>
  <div class="status-dot" id="status-dot"></div>
</header>

<main>
  <!-- Left: Camera -->
  <div class="panel">
    <div class="panel-title">📷 Live Feed</div>
    <img id="camera-feed" src="" alt="Camera feed">
    <div class="meta" id="meta">
      <div class="meta-item">Frames: <strong id="frame-count">0</strong></div>
      <div class="meta-item">Analyses: <strong id="analysis-count">0</strong></div>
      <div class="meta-item">Model: <strong id="model-label">—</strong></div>
      <div class="meta-item">Δ scene: <strong id="scene-pct">—</strong></div>
    </div>
  </div>

  <!-- Right: AI output + controls -->
  <div class="panel">
    <div class="panel-title">🤖 AI Description</div>
    <div class="description-box" id="desc-box">Waiting for camera…</div>

    <div class="controls">
      <div>
        <label>Model</label>
        <select id="model-select"></select>
      </div>
      <div>
        <label>Analysis interval: <span class="range-val" id="interval-val">3s</span></label>
        <input type="range" id="interval" min="1" max="15" step="0.5" value="3">
      </div>
      <div>
        <label>Custom prompt</label>
        <textarea id="prompt-input">Describe what you see in this image concisely in 1-2 sentences.</textarea>
      </div>
      <div class="btn-row">
        <button id="apply-btn">Apply Settings</button>
        <button id="pause-btn" class="warn">⏸ Pause</button>
        <button id="export-btn" class="secondary">💾 Export History</button>
      </div>
    </div>

    <div class="panel-title" style="margin-top:1.5rem">📝 History</div>
    <div class="history" id="history"></div>
  </div>
</main>

<script>
  const feed      = document.getElementById('camera-feed');
  const descBox   = document.getElementById('desc-box');
  const dot       = document.getElementById('status-dot');
  const lbl       = document.getElementById('status-label');
  const fc        = document.getElementById('frame-count');
  const ac        = document.getElementById('analysis-count');
  const modelLbl  = document.getElementById('model-label');
  const scenePct  = document.getElementById('scene-pct');
  const historyEl = document.getElementById('history');
  const slider    = document.getElementById('interval');
  const iVal      = document.getElementById('interval-val');
  const modelSel  = document.getElementById('model-select');
  const pauseBtn  = document.getElementById('pause-btn');
  const exportBtn = document.getElementById('export-btn');

  slider.addEventListener('input', () => iVal.textContent = slider.value + 's');

  let lastDesc   = '';
  let isPaused   = false;
  let modelsInit = false;

  // ── Polling ────────────────────────────────────────────────
  async function poll() {
    try {
      const r = await fetch('/state');
      const s = await r.json();

      // Camera frame
      if (s.frame_b64) feed.src = 'data:image/jpeg;base64,' + s.frame_b64;

      // Build model dropdown once
      if (!modelsInit && s.available_models && s.available_models.length) {
        modelSel.innerHTML = '';
        for (const m of s.available_models) {
          const opt = document.createElement('option');
          opt.value = m; opt.textContent = m;
          if (m === s.model) opt.selected = true;
          modelSel.appendChild(opt);
        }
        modelsInit = true;
      }

      // Description changed
      if (s.description && s.description !== lastDesc) {
        descBox.textContent = s.description;
        if (lastDesc && !lastDesc.startsWith('❌') &&
            !lastDesc.startsWith('Starting') &&
            !lastDesc.startsWith('Camera ready')) {
          const item = document.createElement('div');
          item.className = 'history-item';
          item.innerHTML = '<div class="ts">' + new Date().toLocaleTimeString() + '</div>' + lastDesc;
          historyEl.prepend(item);
          if (historyEl.children.length > 30) historyEl.lastChild.remove();
        }
        lastDesc = s.description;
      }

      // Status indicator
      if (s.paused) {
        dot.className = 'status-dot paused';
        lbl.textContent = 'paused';
        descBox.className = 'description-box';
      } else if (s.analysing) {
        dot.className = 'status-dot busy';
        lbl.textContent = 'analysing…';
        descBox.className = 'description-box thinking';
      } else {
        dot.className = 'status-dot';
        lbl.textContent = 'watching';
        descBox.className = 'description-box';
      }

      fc.textContent       = s.frame_count;
      ac.textContent       = s.analysis_count;
      modelLbl.textContent = s.model;
      scenePct.textContent = s.scene_change_pct + '%';
      isPaused = s.paused;
      pauseBtn.textContent = isPaused ? '▶ Resume' : '⏸ Pause';
      pauseBtn.className   = isPaused ? 'secondary' : 'warn';

    } catch(e) { lbl.textContent = 'server error'; }
    setTimeout(poll, 800);
  }

  // ── Apply settings ─────────────────────────────────────────
  document.getElementById('apply-btn').addEventListener('click', async () => {
    await fetch('/config', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        model:    modelSel.value,
        interval: parseFloat(slider.value),
        prompt:   document.getElementById('prompt-input').value.trim(),
      })
    });
  });

  // ── Pause / resume ────────────────────────────────────────
  pauseBtn.addEventListener('click', async () => {
    await fetch('/pause', { method: 'POST' });
  });

  // ── Export history ─────────────────────────────────────────
  exportBtn.addEventListener('click', async () => {
    try {
      const r = await fetch('/export');
      const blob = await r.blob();
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href = url;
      a.download = 'ollama_vision_history.json';
      a.click();
      URL.revokeObjectURL(url);
    } catch(e) { alert('Export failed'); }
  });

  poll();
</script>
</body>
</html>
"""


# ── HTTP handler ─────────────────────────────────────────────────────────────
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass  # silence default access-log noise

    def do_GET(self):
        if self.path == "/":
            self._respond(200, "text/html", HTML.encode())

        elif self.path == "/state":
            payload = {k: v for k, v in state.items() if k != "running"}
            self._respond(200, "application/json", json.dumps(payload).encode())

        elif self.path == "/export":
            export = {
                "exported_at": datetime.now().isoformat(),
                "model":       state["model"],
                "entries":     state["history"],
            }
            data = json.dumps(export, indent=2)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Disposition",
                             'attachment; filename="ollama_vision_history.json"')
            self.end_headers()
            self.wfile.write(data.encode())

        else:
            self._respond(404, "text/plain", b"Not found")

    def do_POST(self):
        if self.path == "/config":
            body = self._read_json()
            global prompt
            if "model"    in body: state["model"]    = body["model"]
            if "interval" in body: state["interval"] = max(1.0, float(body["interval"]))
            if "prompt"   in body: prompt            = body["prompt"]
            self._respond(200, "application/json", b'{"ok":true}')

        elif self.path == "/pause":
            state["paused"] = not state["paused"]
            self._respond(200, "application/json",
                          json.dumps({"paused": state["paused"]}).encode())
        else:
            self._respond(404, "text/plain", b"Not found")

    # helpers
    def _read_json(self):
        length = int(self.headers.get("Content-Length", 0))
        return json.loads(self.rfile.read(length)) if length else {}

    def _respond(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.end_headers()
        self.wfile.write(body)


# ── Main ─────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    print("🔍 Checking Ollama models…")
    available = detect_models()
    state["available_models"] = available if available else PREFERRED_MODELS
    if available:
        best = pick_best_model(available)
        state["model"] = best
        print(f"   Found: {', '.join(available)}")
        print(f"   Selected: {best}")
    else:
        state["model"] = "llava"
        print("   ⚠ Could not query Ollama. Defaulting to llava.")
        print("   Make sure Ollama is running:  ollama serve")

    print(f"""
╔══════════════════════════════════════════════╗
║        Ollama Vision — Live Camera           ║
╠══════════════════════════════════════════════╣
║  Model    : {state['model']:<32}║
║  Web UI   : http://localhost:{WEB_PORT:<15}║
║  Interval : {state['interval']}s (scene-change aware)      ║
╠══════════════════════════════════════════════╣
║  Features : pause, model swap, prompt edit   ║
║           : scene-change detection           ║
║           : history export (JSON)            ║
║  Press Ctrl+C to stop                        ║
╚══════════════════════════════════════════════╝
""")

    threading.Thread(target=camera_loop,   daemon=True, name="camera").start()
    threading.Thread(target=analysis_loop, daemon=True, name="analysis").start()

    server = HTTPServer(("0.0.0.0", WEB_PORT), Handler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        state["running"] = False
        print("\n👋 Stopped.")
